{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "no_devices_found": "[%key:common::config_flow::abort::no_devices_found%]"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "flow_title": "{model} ({host})",
    "step": {
      "discovery_auth": {
        "data": {
          "device_id": "Device ID",
          "host": "[%key:common::config_flow::data::ip%]",
          "token": "[%key:common::config_flow::data::api_token%]"
        },
        "description": "[%key:component::xiaomi_lumi_acpartner_mcn02::config::step::user::description%]"
      },
      "user": {
        "data": {
          "host": "[%key:common::config_flow::data::ip%]",
          "token": "[%key:common::config_flow::data::api_token%]"
        },
        "description": "You will need the 32 character API token, see {retrieving_token_url} for instructions. Please note that this API token is different from the key used by the Xiaomi Aqara integration."
      }
    }
  },
  "device": {
    "air_conditioning_companion_mcn02": {
      "name": "Mi Smart Air Conditioner Controller 2"
    }
  },
  "entity": {
    "binary_sensor": {
      "match_state": {
        "name": "Match State",
        "state": {
          "off": "Out of matching",
          "on": "Matching"
        }
      }
    },
    "climate": {
      "ac": {
        "name": "Air Conditioner"
      }
    },
    "select": {
      "ac_mode": {
        "name": "AC Work Mode",
        "state": {
          "0": "With outlet",
          "1": "Without outlet"
        }
      }
    },
    "switch": {
      "en_nnlight": {
        "name": "en_nnlight"
      }
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "max_temp": "Max temperature",
          "min_temp": "Min temperature"
        }
      }
    }
  }
}
